[
  {
    "id": "T1190",
    "name": "Exploit Public-Facing Application",
    "tactics": [
      "ia"
    ],
    "severity": 4,
    "patterns": [
      {
        "regex": "union(\\s|%20|\\+|\\/\\*\\*\\/)+(all(\\s|%20|\\+)+)?select",
        "flags": "i",
        "weight": 3
      },
      {
        "regex": "(%27|')(\\s|%20|\\+)*or(\\s|%20|\\+)+('|%27)?\\d+('|%27)?(\\s|%20)*=(\\s|%20)*('|%27)?\\d+",
        "flags": "i",
        "weight": 3
      },
      {
        "regex": "\\$\\{jndi:",
        "flags": "i",
        "weight": 3
      },
      {
        "regex": "(\\.\\.\\/){2,}|(%2e%2e(%2f|\\/)){2,}|(\\.\\.%2f){2,}",
        "flags": "i",
        "weight": 2
      },
      {
        "regex": "\\/etc\\/passwd",
        "flags": "i",
        "weight": 2
      },
      {
        "regex": "(%3c|<)script",
        "flags": "i",
        "weight": 2
      },
      {
        "regex": "(;|%3b|\\||%7c)(\\s|%20|\\+)*(cat|id|whoami|uname|wget|curl)\\b",
        "flags": "i",
        "weight": 2
      }
    ],
    "d3fend": [
      "SU",
      "CSPP",
      "ITF",
      "ACH"
    ],
    "checks": [
      "Vérifier le code HTTP : un 200 sur une injection vaut plus qu’un 404.",
      "Chercher des processus lancés par le serveur web juste après."
    ]
  },
  {
